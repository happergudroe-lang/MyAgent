# Supabase PostgreSQL connection string (use the Session Pooler URL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:6543/postgres

# Add at least one model provider key on the hosting platform
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODELS=
TAVILY_API_KEY=


# Voice provider: local | openai | elevenlabs | minimax | fish
VOICE_PROVIDER=local
VOICE_STUDIO_URL=http://127.0.0.1:3900
VOICE_STUDIO_ASR_URL=http://127.0.0.1:3901

# OpenAI cloud speech (server-side only)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_INSTRUCTIONS=Speak naturally and conversationally.

# ElevenLabs cloud TTS, Scribe ASR and Instant Voice Clone
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v1

# MiniMax cloud TTS (ASR/clone not implemented in this adapter)
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo

# Fish Audio reserved; not available until its adapter is implemented
FISH_AUDIO_API_KEY=
