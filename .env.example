# Supabase PostgreSQL connection string (use the Session Pooler URL)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:6543/postgres

# Add at least one model provider key on the hosting platform
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODELS=
TAVILY_API_KEY=

# WeCom self-built application callback (keep secrets server-side)
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=

# Agent routing: my | openai | claude | gemini | deepseek
WECOM_DEFAULT_PROVIDER=my
WECOM_GPT_MODEL=gpt-4o-mini
WECOM_CLAUDE_MODEL=claude-sonnet-4-5
WECOM_GEMINI_MODEL=gemini-2.5-flash
WECOM_DEEPSEEK_MODEL=deepseek-chat
MY_BASE_URL=
MY_MODEL=myrqvia
