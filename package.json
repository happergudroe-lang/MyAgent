{
  "name": "myagent",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "db:info": "echo 'Run supabase/schema.sql in the Supabase SQL Editor'",
    "start": "tsx server/index.ts",
    "prebuild": "node scripts/gen-brand.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "rehype-highlight": "^7.0.2",
    "highlight.js": "^11.11.1",
    "mathjs": "^14.2.1",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.1",
    "@uzen/kokoro-js": "^1.2.4",
    "@huggingface/transformers": "^4.3.2",
    "react-virtuoso": "^4.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "latest",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.11"
  },
  "engines": {
    "node": ">=20"
  }
}
